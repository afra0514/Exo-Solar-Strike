{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Exo Solar Strike",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${fileDirname}\\main.cpp",
                "${fileDirname}\\globals.cpp",
                "${fileDirname}\\utils.cpp",
                "${fileDirname}\\simulation.cpp",
                "${fileDirname}\\game.cpp",
                "${fileDirname}\\info.cpp",
                "-o",
                "${fileDirname}\\main.exe",
                "-I", "C:\\MinGW\\include",
                "-L", "C:\\MinGW\\lib",
                "-lfreeglut",
                "-lopengl32",
                "-lglu32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles all 6 modular source files with Sound Support."
        }
    ]
}